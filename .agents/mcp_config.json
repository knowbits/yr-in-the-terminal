{
  "mcpServers": {
    "ast-grep": {
      "type": "stdio",
      "command": "python3",
      "args": ["scripts-AI/ast_grep_mcp_server.py"]
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "env": {
        "CODEGRAPH_MCP_TOOLS": "node,impact"
      }
    }
  }
}
